{
  "execution_scope": "mvp",
  "seed": 42,
  "data_dir": "data/rcaeval",
  "backbone_dir": "artifacts/backbone",
  "artifact_root": "artifacts/retrain/hybrid_frozen",
  "max_length": 2048,
  "epochs": 24,
  "batch_size": 1,
  "gradient_accumulation": 4,
  "learning_rate_sft": 2e-05,
  "learning_rate_frozen": 0.001,
  "weight_decay": 0.01,
  "loss_weights": [
    1,
    1
  ],
  "head_size": 128,
  "train_device": "cuda",
  "inference_device": "cpu",
  "cpu_threads": 8,
  "gradient_checkpointing": true,
  "early_stopping_patience": 6,
  "max_steps": 312,
  "calibration_min_samples": 10,
  "target_joint_risk": 0.05,
  "min_accepted_runs": 30,
  "ece_bins": 10,
  "benchmark_warmup": 3,
  "benchmark_repeats": 12,
  "execute_remediation": false,
  "external_llm_enabled": false,
  "backbone_learning_rate": 2e-05,
  "head_learning_rate": 0.001,
  "schedule": "linear",
  "warmup_fraction": 0.05,
  "augmentation": {
    "candidate_shuffle": true,
    "evidence_dropout": 0.0,
    "metric_dropout": 0.05
  },
  "serializer_version": "metrics-canonical-v2",
  "pooling": "mean",
  "numeric_fusion": true,
  "numeric_metrics": [
    "cpu",
    "error",
    "latency",
    "latency-50",
    "latency-90",
    "load",
    "mem",
    "workload"
  ]
}